# Evergreen configuration. Copy to `.env` and fill in.
#
#     cp .env.example .env
#
# Only OPENAI_API_KEY is needed to run locally. Everything marked REQUIRED FOR
# PRODUCTION is checked by the startup audit — with EVERGREEN_ENV=production the
# app REFUSES TO BOOT until they are set. That is deliberate: each one is
# something that would be unsafe or unlawful to serve to the public without.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Chat assistant. Required for the chat tab; the rest of the app works without.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TIMEOUT_SECONDS=75
# OPENAI_MAX_COMPLETION_TOKENS=900  # clamped by the app to 128..2000

# "development" (default) or "production". Production turns the startup audit's
# warnings into hard failures.
EVERGREEN_ENV=development


# ---------------------------------------------------------------------------
# Encryption at rest  —  REQUIRED FOR PRODUCTION
# ---------------------------------------------------------------------------
# Wraps the data key that encrypts portfolios, chat content/titles, investor
# profiles and TOTP secrets. Generate one with:
#
#     python -m api.crypto keygen
#
# Store it in a secret manager, NOT in this file, for a real deployment.
#
# !! LOSING THIS KEY MEANS LOSING EVERY PORTFOLIO IN THE DATABASE. !!
# !! Back it up separately from your database backups.             !!
#
# To rotate: put the new key first, keep the old one second. The app re-wraps
# the data key on next boot; no data migration is needed. Drop the old key on a
# later deploy.
#     EVERGREEN_MASTER_KEY=<new-key>,<old-key>
EVERGREEN_MASTER_KEY=

# Without this, a development key is written to `.evergreen_key` in the working
# directory. Fine for local work; never acceptable in production.

# Whole-backup authenticated encryption. This MUST be different from
# EVERGREEN_MASTER_KEY and must be escrowed separately. Generate with:
#
#     python scripts/backup_db.py --generate-key
#
# The backup/verify/restore commands accept current,old during key rotation.
BACKUP_ENCRYPTION_KEY=


# ---------------------------------------------------------------------------
# Market data  —  REQUIRED FOR PRODUCTION
# ---------------------------------------------------------------------------
# yfinance (the default) uses Yahoo endpoints. This project has not established
# public display/redistribution/commercial-use rights for that adapter, and it
# is operationally unsuitable for a public dependency. Production blocks it.
#
#   yfinance  development only (default)
#   stooq     keyless fallback, prices only; do not assume redistribution rights
#   tiingo    production-capable adapter — needs TIINGO_API_KEY
#   polygon   production-capable adapter — needs POLYGON_API_KEY
MARKET_DATA_PROVIDER=yfinance
# Set true ONLY after confirming that the provider contract for this account
# permits this exact public display/redistribution use. An API key or paid plan
# alone is not proof of redistribution rights; production refuses to boot
# without this explicit operator acknowledgement.
MARKET_DATA_REDISTRIBUTION_ENTITLED=
# TIINGO_API_KEY=
# POLYGON_API_KEY=


# ---------------------------------------------------------------------------
# Shared state  —  REQUIRED TO RUN MORE THAN ONE WORKER
# ---------------------------------------------------------------------------
# Rate-limit windows, account lockouts and pending-2FA handles. Without Redis
# these live in process memory. Redis globalizes this security state, but the
# SQLite-backed public app still runs as one process/replica until its database
# and long-running job controls are replaced with distributed services.
# REDIS_URL=redis://localhost:6379/0


# ---------------------------------------------------------------------------
# Email  —  REQUIRED FOR PRODUCTION
# ---------------------------------------------------------------------------
# Email verification gates the whole app, so without a working sender nobody
# can get past sign-up. Restricted, send-only key from https://resend.com
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=


# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
# Comma-separated allowed CORS origins. Defaults to localhost when unset.
APP_ORIGINS=

# Domain Caddy fetches a TLS certificate for (docker-compose).
DOMAIN=

# Compose defaults this to Caddy's fixed internal IP. Never use "*". Set an
# explicit IP/CIDR only when replacing Caddy with another trusted proxy.
# TRUSTED_PROXY_IPS=172.31.254.10


# ---------------------------------------------------------------------------
# Public policy/operator fields  —  REQUIRED FOR PRODUCTION
# ---------------------------------------------------------------------------
# These values are rendered into Terms and Privacy. Do not claim review until
# qualified counsel has reviewed the actual service and jurisdictions.
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_JURISDICTION=
HOSTING_REGION=
LOG_RETENTION_DAYS=
BACKUP_RETENTION_DAYS=
LEGAL_REVIEW_CONFIRMED=


# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
# LOG_LEVEL=INFO
# LOG_FORMAT=json            # "text" is easier to read while developing
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0


# ---------------------------------------------------------------------------
# Optional behaviour
# ---------------------------------------------------------------------------
# SENTIMENT_BACKEND=finbert  # needs `pip install transformers` (~440MB download)
# AGENT_VERBOSE=0            # 1 logs the agent's tool-calling trace
